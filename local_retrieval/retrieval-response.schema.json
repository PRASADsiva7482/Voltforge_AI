{
  "$defs": {
    "IndexedFact": {
      "additionalProperties": false,
      "properties": {
        "factId": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,199}$",
          "title": "Factid",
          "type": "string"
        },
        "claimId": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,199}$",
          "title": "Claimid",
          "type": "string"
        },
        "property": {
          "pattern": "^[a-z][a-z0-9-]{1,79}$",
          "title": "Property",
          "type": "string"
        },
        "pointer": {
          "maxLength": 500,
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "status": {
          "enum": [
            "verified",
            "bounded",
            "conditional",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Conditions",
          "type": "array"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidencerefs",
          "type": "array"
        }
      },
      "required": [
        "factId",
        "claimId",
        "property",
        "pointer",
        "status",
        "evidenceRefs"
      ],
      "title": "IndexedFact",
      "type": "object"
    },
    "RetrievalCitation": {
      "additionalProperties": false,
      "properties": {
        "citationId": {
          "pattern": "^citation:local:[a-f0-9]{24}$",
          "title": "Citationid",
          "type": "string"
        },
        "sourceId": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,199}$",
          "title": "Sourceid",
          "type": "string"
        },
        "sourceRevision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Sourcerevision",
          "type": "string"
        },
        "recordId": {
          "pattern": "^vf-knowledge-v1-[a-z0-9][a-z0-9.-]{2,119}$",
          "title": "Recordid",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "locator": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "contentSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contentsha256",
          "type": "string"
        }
      },
      "required": [
        "citationId",
        "sourceId",
        "sourceRevision",
        "recordId",
        "title",
        "locator",
        "contentSha256"
      ],
      "title": "RetrievalCitation",
      "type": "object"
    },
    "RetrievalEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,199}$",
          "title": "Evidenceid",
          "type": "string"
        },
        "evidenceKind": {
          "enum": [
            "manufacturer-documentation",
            "maintainer-documentation",
            "toolchain-documentation",
            "project-engineering-rule"
          ],
          "title": "Evidencekind",
          "type": "string"
        },
        "publisher": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "documentRevision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Documentrevision",
          "type": "string"
        },
        "locator": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "verifiedAt": {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$",
          "title": "Verifiedat",
          "type": "string"
        }
      },
      "required": [
        "evidenceId",
        "evidenceKind",
        "publisher",
        "title",
        "documentRevision",
        "locator",
        "verifiedAt"
      ],
      "title": "RetrievalEvidence",
      "type": "object"
    },
    "RetrievalResult": {
      "additionalProperties": false,
      "properties": {
        "resultId": {
          "pattern": "^retrieval:local:[a-f0-9]{24}$",
          "title": "Resultid",
          "type": "string"
        },
        "rank": {
          "maximum": 8,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Score",
          "type": "string"
        },
        "matchedTerms": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Matchedterms",
          "type": "array"
        },
        "chunkId": {
          "pattern": "^vf-retrieval-chunk-v1-[a-f0-9]{24}$",
          "title": "Chunkid",
          "type": "string"
        },
        "recordId": {
          "pattern": "^vf-knowledge-v1-[a-z0-9][a-z0-9.-]{2,119}$",
          "title": "Recordid",
          "type": "string"
        },
        "recordType": {
          "enum": [
            "board",
            "pin-map",
            "component",
            "wiring-recipe",
            "firmware-api",
            "compiler-diagnostic",
            "simulation-behavior",
            "safety-constraint"
          ],
          "title": "Recordtype",
          "type": "string"
        },
        "supportStatus": {
          "enum": [
            "supported",
            "variant-required",
            "reference-only"
          ],
          "title": "Supportstatus",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/RetrievalSubject"
        },
        "source": {
          "$ref": "#/$defs/RetrievalSource"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/IndexedFact"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/RetrievalEvidence"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "contentSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contentsha256",
          "type": "string"
        },
        "citation": {
          "$ref": "#/$defs/RetrievalCitation"
        }
      },
      "required": [
        "resultId",
        "rank",
        "score",
        "matchedTerms",
        "chunkId",
        "recordId",
        "recordType",
        "supportStatus",
        "subject",
        "source",
        "facts",
        "evidence",
        "contentSha256",
        "citation"
      ],
      "title": "RetrievalResult",
      "type": "object"
    },
    "RetrievalSource": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "const": "vf-src-curated-electronics-corpus-v1",
          "title": "Sourceid",
          "type": "string"
        },
        "sourceRevision": {
          "const": "1.1.0",
          "title": "Sourcerevision",
          "type": "string"
        },
        "recordRevision": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,199}$",
          "title": "Recordrevision",
          "type": "string"
        },
        "validFrom": {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$",
          "title": "Validfrom",
          "type": "string"
        },
        "recordId": {
          "pattern": "^vf-knowledge-v1-[a-z0-9][a-z0-9.-]{2,119}$",
          "title": "Recordid",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "sourceRevision",
        "recordRevision",
        "validFrom",
        "recordId"
      ],
      "title": "RetrievalSource",
      "type": "object"
    },
    "RetrievalSubject": {
      "additionalProperties": false,
      "properties": {
        "subjectId": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,199}$",
          "title": "Subjectid",
          "type": "string"
        },
        "familyId": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,199}$",
          "title": "Familyid",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "variant": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "subjectId",
        "familyId",
        "name",
        "variant"
      ],
      "title": "RetrievalSubject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "contractVersion": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contractversion",
      "type": "string"
    },
    "policyId": {
      "const": "vfai022-curated-local-retrieval-v1",
      "default": "vfai022-curated-local-retrieval-v1",
      "title": "Policyid",
      "type": "string"
    },
    "policySha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policysha256",
      "type": "string"
    },
    "responseId": {
      "pattern": "^vf-retrieval-response-v1-[a-f0-9]{24}$",
      "title": "Responseid",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "no-results",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "reasonCode": {
      "pattern": "^[A-Z][A-Z0-9_]{2,99}$",
      "title": "Reasoncode",
      "type": "string"
    },
    "querySha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Querysha256",
      "type": "string"
    },
    "indexId": {
      "const": "vf-curated-local-index-v1",
      "title": "Indexid",
      "type": "string"
    },
    "indexVersion": {
      "const": "1.1.0",
      "title": "Indexversion",
      "type": "string"
    },
    "indexSha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Indexsha256"
    },
    "sourceId": {
      "const": "vf-src-curated-electronics-corpus-v1",
      "title": "Sourceid",
      "type": "string"
    },
    "sourceRevision": {
      "const": "1.1.0",
      "title": "Sourcerevision",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/RetrievalResult"
      },
      "maxItems": 8,
      "title": "Results",
      "type": "array"
    },
    "candidateCount": {
      "default": 0,
      "minimum": 0,
      "title": "Candidatecount",
      "type": "integer"
    },
    "returnedCount": {
      "default": 0,
      "maximum": 8,
      "minimum": 0,
      "title": "Returnedcount",
      "type": "integer"
    },
    "filtersApplied": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Filtersapplied",
      "type": "object"
    },
    "degraded": {
      "default": false,
      "title": "Degraded",
      "type": "boolean"
    },
    "embeddingsUsed": {
      "const": false,
      "default": false,
      "title": "Embeddingsused",
      "type": "boolean"
    },
    "networkAccessed": {
      "const": false,
      "default": false,
      "title": "Networkaccessed",
      "type": "boolean"
    },
    "rawQueryStored": {
      "const": false,
      "default": false,
      "title": "Rawquerystored",
      "type": "boolean"
    },
    "rawProjectContextStored": {
      "const": false,
      "default": false,
      "title": "Rawprojectcontextstored",
      "type": "boolean"
    }
  },
  "required": [
    "policySha256",
    "responseId",
    "status",
    "reasonCode",
    "querySha256",
    "indexId",
    "indexVersion",
    "sourceId",
    "sourceRevision"
  ],
  "title": "VoltForge curated local retrieval response v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voltforge-ai:curated-local-retrieval-response:v1"
}
