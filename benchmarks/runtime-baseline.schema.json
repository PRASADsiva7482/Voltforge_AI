{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voltforge-ai:runtime-baseline:v1",
  "title": "VoltForge AI offline runtime baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "generatedAt",
    "networkAccessAllowed",
    "revision",
    "configuration",
    "hardware",
    "software",
    "model",
    "benchmarks",
    "derivedBudgets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "type": "string", "pattern": "^vfai-runtime-[0-9]{8}T[0-9]{6}Z$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "networkAccessAllowed": { "const": false },
    "revision": { "type": "object" },
    "configuration": {
      "type": "object",
      "required": ["coldStartRuns", "warmupRequests", "measuredRequests", "concurrencyLevels"]
    },
    "hardware": {
      "type": "object",
      "required": ["referenceTier", "operatingSystem", "cpu", "memory", "storage", "accelerator"]
    },
    "software": {
      "type": "object",
      "required": ["python", "packages"]
    },
    "model": {
      "type": "object",
      "required": ["health", "neuralGeneration"]
    },
    "benchmarks": {
      "type": "object",
      "required": ["coldStart", "localDeterministicGeneration"],
      "properties": {
        "coldStart": {
          "type": "object",
          "required": ["scope", "runs", "processLaunchToReady", "serviceImport", "artifactHealthResolution", "peakWorkingSet"]
        },
        "localDeterministicGeneration": {
          "type": "object",
          "required": [
            "mode",
            "outputUnit",
            "tokenMetricsApplicable",
            "networkAccessAllowed",
            "firstDeltaLatency",
            "generationThroughput",
            "memory",
            "concurrency"
          ],
          "properties": {
            "mode": { "const": "local-deterministic" },
            "outputUnit": { "const": "characters" },
            "tokenMetricsApplicable": { "const": false },
            "networkAccessAllowed": { "const": false },
            "concurrency": { "type": "array", "minItems": 1 }
          }
        }
      }
    },
    "derivedBudgets": {
      "type": "object",
      "required": ["profile", "sourceBenchmarkId", "basis", "notBasedOn", "calculation", "limits"]
    }
  }
}
