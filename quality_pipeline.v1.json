{
  "schemaVersion": 1,
  "pipelineId": "vfai032-cross-repository-quality-v1",
  "productBoundary": "VoltForge-owned local generation only; internet is evidence retrieval, never generation.",
  "sourceRoots": {
    "ai": "Voltforge_AI",
    "backend": "Voltforge_BL",
    "ui": "Voltforge_UI"
  },
  "toolPlaceholders": ["__AI_PYTHON__", "__MAVEN__", "__NPM__", "__GIT__"],
  "releaseRequirements": {
    "allowedLanes": ["model", "all"],
    "cleanWorktrees": ["Voltforge_AI", "Voltforge_BL", "Voltforge_UI"],
    "allSelectedChecksMustPass": true,
    "modelLaneMustRun": true
  },
  "sourceFingerprintExclusions": [
    ".git",
    ".toolchains",
    "node_modules",
    "dist",
    "target",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".venv",
    "runtime",
    "evaluation/reports",
    "evaluation/snapshots",
    "benchmarks/reports",
    "model/registry/reports",
    "electronics_corpus/reports",
    "data_governance/reports",
    "synthetic_data/reports"
  ],
  "checks": [
    {
      "id": "ai-quality-boundaries",
      "lane": "fast",
      "category": "artifact-and-provider-scan",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/scan_quality_boundaries.py", "--check"],
      "timeoutSeconds": 120
    },
    {
      "id": "ai-runbook-contract",
      "lane": "fast",
      "category": "operations-contract",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/verify_runbook.py"],
      "timeoutSeconds": 120
    },
    {
      "id": "ai-hardware-coverage",
      "lane": "fast",
      "category": "cross-repository-catalog-boundary",
      "cwd": "Voltforge_AI",
      "command": [
        "__AI_PYTHON__", "tools/verify_hardware_coverage.py",
        "--ui-catalog", "../Voltforge_UI/src/features/canvas/boardCatalog.ts"
      ],
      "timeoutSeconds": 120
    },
    {
      "id": "ai-unit-contract-tests",
      "lane": "fast",
      "category": "python-tests",
      "cwd": "Voltforge_AI",
      "command": [
        "__AI_PYTHON__", "-m", "pytest", "-q",
        "tests/test_api.py",
        "tests/test_api_contract.py",
        "tests/test_chat_stream.py",
        "tests/test_context_compiler.py",
        "tests/test_data_governance.py",
        "tests/test_electronics_corpus.py",
        "tests/test_engineering_tools.py",
        "tests/test_feedback_governance.py",
        "tests/test_generation_quality.py",
        "tests/test_hardware_coverage.py",
        "tests/test_grounding.py",
        "tests/test_internet_retrieval.py",
        "tests/test_local_retrieval.py",
        "tests/test_memory_store.py",
        "tests/test_model_identity.py",
        "tests/test_observability.py",
        "tests/test_registry_manager.py",
        "tests/test_registry_observability.py",
        "tests/test_release_lifecycle.py",
        "tests/test_runtime_service.py",
        "tests/test_security_boundaries.py",
        "tests/test_task_schema.py",
        "tests/test_verifier.py"
      ],
      "timeoutSeconds": 1800
    },
    {
      "id": "ai-evaluation-leakage",
      "lane": "fast",
      "category": "evaluation-integrity",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/check_evaluation_leakage.py"],
      "timeoutSeconds": 600
    },
    {
      "id": "ai-data-governance",
      "lane": "fast",
      "category": "data-governance",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/audit_data_governance.py", "--check"],
      "timeoutSeconds": 600
    },
    {
      "id": "ai-task-schema",
      "lane": "fast",
      "category": "schema-drift",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/check_task_schema.py"],
      "timeoutSeconds": 120
    },
    {
      "id": "ai-registry-integrity",
      "lane": "fast",
      "category": "artifact-integrity",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/manage_model_registry.py", "verify"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-api-contract-evaluation",
      "lane": "fast",
      "category": "quality-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_api_contract.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-generation-quality-evaluation",
      "lane": "fast",
      "category": "quality-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_generation_quality_gates.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-grounding-evaluation",
      "lane": "fast",
      "category": "quality-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_claim_grounding.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-internet-boundary-evaluation",
      "lane": "fast",
      "category": "offline-security-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_internet_retrieval.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-local-retrieval-evaluation",
      "lane": "fast",
      "category": "quality-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_local_retrieval.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-memory-evaluation",
      "lane": "fast",
      "category": "privacy-and-memory-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_bounded_memory.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-context-evaluation",
      "lane": "fast",
      "category": "context-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_context_compiler.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-engineering-tools-evaluation",
      "lane": "fast",
      "category": "deterministic-tool-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_engineering_tools.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-observability-evaluation",
      "lane": "fast",
      "category": "observability-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_ai_observability.py", "evaluate"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-proposal-transaction-evaluation",
      "lane": "fast",
      "category": "safety-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_ai_proposal_transaction.py"],
      "timeoutSeconds": 300
    },
    {
      "id": "ai-security-threat-model-evaluation",
      "lane": "fast",
      "category": "security-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_ai_security_threat_model.py"],
      "timeoutSeconds": 300
    },
    {
      "id": "spring-gateway-evaluation",
      "lane": "fast",
      "category": "backend-boundary-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_spring_gateway.py"],
      "timeoutSeconds": 300
    },
    {
      "id": "ui-ai-boundary-evaluation",
      "lane": "fast",
      "category": "ui-boundary-evaluation",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/evaluate_ui_ai_status.py"],
      "timeoutSeconds": 300
    },
    {
      "id": "backend-tests",
      "lane": "fast",
      "category": "backend-tests",
      "cwd": "Voltforge_BL",
      "command": ["__MAVEN__", "-q", "test"],
      "timeoutSeconds": 1800
    },
    {
      "id": "ui-tests",
      "lane": "fast",
      "category": "ui-tests",
      "cwd": "Voltforge_UI",
      "command": ["__NPM__", "test"],
      "timeoutSeconds": 1800
    },
    {
      "id": "ui-production-build-and-budget",
      "lane": "fast",
      "category": "ui-build",
      "cwd": "Voltforge_UI",
      "command": ["__NPM__", "run", "build"],
      "timeoutSeconds": 1800
    },
    {
      "id": "ai-whitespace-check",
      "lane": "fast",
      "category": "repository-hygiene",
      "cwd": "Voltforge_AI",
      "command": ["__GIT__", "diff", "--check"],
      "timeoutSeconds": 120
    },
    {
      "id": "backend-whitespace-check",
      "lane": "fast",
      "category": "repository-hygiene",
      "cwd": "Voltforge_BL",
      "command": ["__GIT__", "diff", "--check"],
      "timeoutSeconds": 120
    },
    {
      "id": "ui-whitespace-check",
      "lane": "fast",
      "category": "repository-hygiene",
      "cwd": "Voltforge_UI",
      "command": ["__GIT__", "diff", "--check"],
      "timeoutSeconds": 120
    },
    {
      "id": "gen1-model-tests",
      "lane": "model",
      "category": "model-heavy-tests",
      "cwd": "Voltforge_AI",
      "command": [
        "__AI_PYTHON__", "-m", "pytest", "-q",
        "tests/test_gen1_model.py",
        "tests/test_gen1_training.py",
        "tests/test_gen1_sweep.py",
        "tests/test_gen1_bootstrap.py",
        "tests/test_gen1_decision.py",
        "tests/test_gen1_runtime.py",
        "tests/test_gen1_optimization.py"
      ],
      "timeoutSeconds": 3600
    },
    {
      "id": "gen1-runtime-offline-smoke",
      "lane": "model",
      "category": "offline-model-smoke",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/smoke_gen1_runtime.py", "--device", "cpu"],
      "timeoutSeconds": 900
    },
    {
      "id": "gen1-optimization-offline-smoke",
      "lane": "model",
      "category": "offline-model-smoke",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/smoke_gen1_optimization.py"],
      "timeoutSeconds": 900
    },
    {
      "id": "model-release-scorecard",
      "lane": "model",
      "category": "model-release-gate",
      "cwd": "Voltforge_AI",
      "command": ["__AI_PYTHON__", "tools/run_release_evaluation.py", "--require-pass"],
      "timeoutSeconds": 1800
    }
  ]
}
