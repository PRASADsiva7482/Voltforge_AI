# VoltForge AI local configuration. Never commit a populated .env file.
VOLTFORGE_AI_ENVIRONMENT=development
# VoltForge AI microservice configuration. Never commit a populated .env file.
VOLTFORGE_AI_HOST=127.0.0.1
VOLTFORGE_AI_PORT=2002
VOLTFORGE_AI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VOLTFORGE_AI_MAX_REQUEST_BYTES=2000000
VOLTFORGE_AI_CHAT_REQUEST_TIMEOUT_SECONDS=15
VOLTFORGE_AI_MAX_CONTEXT_CHARACTERS=48000
# Content-free observability thresholds. Telemetry is process-local and bounded.
VOLTFORGE_AI_OBSERVABILITY_LATENCY_ALERT_MS=10000
VOLTFORGE_AI_OBSERVABILITY_ACTIVE_REQUEST_ALERT=32
VOLTFORGE_AI_OBSERVABILITY_FALLBACK_ALERT_COUNT=5
VOLTFORGE_AI_OBSERVABILITY_RETRIEVAL_ERROR_ALERT_COUNT=5

# ── Service-to-Service AI API Key / Shared Secret ────────────────────────────
# Configure the exact same token in both Python AI (VOLTFORGE_AI_API_TOKEN)
# and Java Backend (VOLTFORGE_AI_API_TOKEN) for secured internal communication.
VOLTFORGE_AI_API_TOKEN=replace-with-a-long-random-service-token
VOLTFORGE_AI_RUNTIME_DIRECTORY=runtime

# ── Internet Retrieval / Web Search ──────────────────────────────────────────
# Optional evidence retrieval. Response generation remains fully local.
VOLTFORGE_AI_INTERNET_RETRIEVAL_ENABLED=false
VOLTFORGE_AI_INTERNET_RETRIEVAL_TIMEOUT_SECONDS=2
VOLTFORGE_AI_INTERNET_RETRIEVAL_PROVIDER=duckduckgo-instant-answer-v1
VOLTFORGE_AI_INTERNET_RETRIEVAL_MAX_RESPONSE_BYTES=262144
VOLTFORGE_AI_INTERNET_RETRIEVAL_CACHE_TTL_SECONDS=900

# Bounded memory is disabled per user/project until the user explicitly enables it.
# A non-empty private service token is required before authenticated memory can run.
VOLTFORGE_AI_BOUNDED_MEMORY_ENABLED=true
VOLTFORGE_AI_MEMORY_DATABASE_PATH=bounded-memory-v1.sqlite3

# ── Database Persistence ─────────────────────────────────────────────────────
# Persistence is opt-in. The service has no embedded host or password default.
VOLTFORGE_AI_DB_ENABLED=false
VOLTFORGE_AI_DB_HOST=127.0.0.1
VOLTFORGE_AI_DB_PORT=3306
VOLTFORGE_AI_DB_NAME=voltforge_ai
VOLTFORGE_AI_DB_USERNAME=voltforge
VOLTFORGE_AI_DB_PASSWORD=
# Deprecated and ignored: raw conversation persistence is permanently disabled.
VOLTFORGE_AI_STORE_CONVERSATIONS=false
# Local Gen1 device selection: auto, cpu, cuda, or mps. No remote device exists.
VOLTFORGE_AI_MODEL_DEVICE=auto

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

