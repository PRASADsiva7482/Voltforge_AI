# VoltForge AI local configuration. Never commit a populated .env file.
VOLTFORGE_AI_HOST=127.0.0.1
VOLTFORGE_AI_PORT=2002
VOLTFORGE_AI_ALLOWED_ORIGINS=http://localhost:3000
VOLTFORGE_AI_MAX_REQUEST_BYTES=2000000
VOLTFORGE_AI_MAX_CONTEXT_CHARACTERS=48000

# Configure the same value in the Java backend environment.
VOLTFORGE_AI_API_TOKEN=replace-with-a-long-random-service-token

# Optional evidence retrieval. Response generation remains fully local.
VOLTFORGE_AI_INTERNET_RETRIEVAL_ENABLED=false
VOLTFORGE_AI_INTERNET_RETRIEVAL_TIMEOUT_SECONDS=2

# Persistence is opt-in. The service has no embedded host or password default.
VOLTFORGE_AI_DB_ENABLED=false
VOLTFORGE_AI_DB_HOST=127.0.0.1
VOLTFORGE_AI_DB_PORT=3306
VOLTFORGE_AI_DB_NAME=voltforge_ai
VOLTFORGE_AI_DB_USERNAME=voltforge
VOLTFORGE_AI_DB_PASSWORD=
VOLTFORGE_AI_STORE_CONVERSATIONS=false
