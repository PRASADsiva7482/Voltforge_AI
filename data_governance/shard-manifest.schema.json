{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voltforge:data-governance:shard-manifest:v1",
  "type": "object",
  "required": ["schemaVersion", "shardId", "path", "recordFormat", "recordCount", "sizeBytes", "sha256", "status", "eligibleUses", "sourceRegistry", "sources", "producer", "preprocessing", "taskSchema", "recordProvenance", "retention", "manifestSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "shardId": {"type": "string", "pattern": "^vf-shard-[0-9a-f]{20}$"},
    "path": {"type": "string", "minLength": 1},
    "recordFormat": {"type": "string", "minLength": 1},
    "recordCount": {"type": "integer", "minimum": 0},
    "sizeBytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["approved", "quarantined"]},
    "eligibleUses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reason": {"type": ["string", "null"]},
    "createdAtUtc": {"type": "string", "minLength": 1},
    "sourceRegistry": {"type": "object"},
    "sources": {"type": "array", "minItems": 1},
    "producer": {"type": "object"},
    "preprocessing": {"type": "object"},
    "taskSchema": {"type": "object"},
    "recordProvenance": {"type": "object"},
    "retention": {"type": "object"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
