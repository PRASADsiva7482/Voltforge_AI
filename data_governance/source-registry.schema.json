{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voltforge:data-governance:source-registry:v1",
  "type": "object",
  "required": ["schemaVersion", "registryId", "version", "policy", "sources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "registryId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "name", "kind", "origin", "revision", "license", "privacy", "allowedUses", "prohibitedUses", "approval", "preprocessing", "checksum", "retention", "deletionProcedure"],
        "properties": {
          "sourceId": {"type": "string", "pattern": "^vf-src-[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "origin": {"type": "object", "required": ["type", "path", "owner", "evidence"]},
          "revision": {"type": "string", "minLength": 1},
          "license": {"type": "object", "required": ["status", "identifier", "copyrightHolder", "evidence"]},
          "privacy": {"type": "object", "required": ["classification", "containsPrivateUserData", "trainingAllowed", "consentRequired"]},
          "allowedUses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "prohibitedUses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "approval": {"type": "object", "required": ["status", "approvedUses", "basis"]},
          "preprocessing": {"type": "object", "required": ["id", "version", "path"]},
          "checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "retention": {"type": "object", "required": ["class", "duration", "reviewTrigger"]},
          "deletionProcedure": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
